{
  "name": "realcredmais",
  "version": "2.0.0",
  "private": true,
  "description": "Site da RealCred+ (Lorena, SP): simulador de consignado no navegador, contato pelo WhatsApp e Netlify Forms.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gerar.mjs && vite --host --port 3000",
    "build": "node scripts/gerar.mjs && vite build",
    "gerar": "node scripts/gerar.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "preview": "vite preview --port 4173",
    "test": "node --test tests/calc.test.js tests/email.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,html,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^15.0.0",
    "prettier": "^3.6.2",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "nodemailer": "10.0.13"
  }
}
